---
const projects = [
  {
    number: "01",
    category: "PERSONAL WEBSITE",
    title: "个人作品集",
    description: "用简洁的设计呈现个人经历、技术能力与代表作品。",
    tags: ["个人主页", "响应式设计"],
    color: "purple",
  },
  {
    number: "02",
    category: "BRAND WEBSITE",
    title: "品牌展示网站",
    description: "通过清晰的内容结构与视觉设计，建立专业的品牌形象。",
    tags: ["品牌展示", "视觉设计"],
    color: "blue",
  },
  {
    number: "03",
    category: "LANDING PAGE",
    title: "产品介绍页面",
    description: "聚焦产品核心卖点，让访客快速了解产品价值。",
    tags: ["产品展示", "落地页"],
    color: "green",
  },
];

const skills = [
  { name: "Astro", level: "静态网站构建" },
  { name: "HTML / CSS", level: "页面结构与视觉设计" },
  { name: "JavaScript", level: "交互功能开发" },
  { name: "Git", level: "代码版本管理" },
  { name: "Deployment", level: "网站部署与上线" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="个人网站作品集，展示网页设计、前端开发和网站部署服务。"
    />
    <meta name="theme-color" content="#09090b" />
    <title>个人作品集 | 将想法变成现实</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #09090b;
        --surface: #111114;
        --text: #f4f4f5;
        --muted: #a1a1aa;
        --line: rgba(255, 255, 255, 0.1);
        --accent: #a78bfa;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 90px;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            ellipse at 50% -20%,
            rgba(124, 58, 237, 0.18),
            transparent 55%
          ),
          var(--bg);
        color: var(--text);
        font-family:
          Inter, "PingFang SC", "Microsoft YaHei", sans-serif;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      .container {
        width: min(var(--max-width), calc(100% - 48px));
        margin: 0 auto;
      }

      .nav {
        position: sticky;
        z-index: 10;
        top: 0;
        border-bottom: 1px solid var(--line);
        background: rgba(9, 9, 11, 0.82);
        backdrop-filter: blur(18px);
      }

      .nav-inner {
        display: flex;
        height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      .brand-icon {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border: 1px solid rgba(167, 139, 250, 0.4);
        border-radius: 11px;
        background: rgba(139, 92, 246, 0.15);
        color: #c4b5fd;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 30px;
        color: var(--muted);
        font-size: 13px;
      }

      .nav-links a {
        transition: color 0.2s;
      }

      .nav-links a:hover {
        color: white;
      }

      .nav-cta {
        padding: 9px 15px;
        border: 1px solid var(--line);
        border-radius: 10px;
        color: var(--text) !important;
      }

      .hero {
        position: relative;
        padding: 112px 0 100px;
      }

      .hero::before {
        position: absolute;
        z-index: -1;
        top: 40px;
        left: 50%;
        width: min(700px, 100%);
        height: 400px;
        background-image: radial-gradient(
          rgba(167, 139, 250, 0.16) 1px,
          transparent 1px
        );
        background-size: 24px 24px;
        content: "";
        mask-image: linear-gradient(to bottom, black, transparent);
        transform: translateX(-50%);
        pointer-events: none;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 7px 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.035);
        color: #d4d4d8;
        font-size: 12px;
      }

      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #86efac;
        box-shadow: 0 0 12px rgba(134, 239, 172, 0.7);
      }

      h1 {
        max-width: 850px;
        margin: 30px 0 22px;
        font-size: clamp(42px, 7vw, 76px);
        font-weight: 800;
        letter-spacing: -3px;
        line-height: 1.16;
      }

      .gradient-text {
        background: linear-gradient(100deg, #c4b5fd, #818cf8 55%, #67e8f9);
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-description {
        max-width: 620px;
        margin: 0;
        color: var(--muted);
        font-size: 16px;
        line-height: 2;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
        margin-top: 34px;
      }

      .button {
        display: inline-flex;
        min-height: 46px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 20px;
        border: 1px solid var(--line);
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        transition:
          transform 0.2s,
          border-color 0.2s,
          background 0.2s;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-primary {
        border-color: transparent;
        background: #f4f4f5;
        color: #18181b;
      }

      .button-primary:hover {
        background: #ddd6fe;
      }

      .button-secondary:hover {
        border-color: rgba(167, 139, 250, 0.5);
        background: rgba(167, 139, 250, 0.08);
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 50px;
        color: var(--muted);
        font-size: 12px;
      }

      .hero-meta span::before {
        margin-right: 8px;
        color: #a78bfa;
        content: "✳";
      }

      .section {
        padding: 76px 0;
        border-top: 1px solid var(--line);
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 32px;
      }

      .section-kicker {
        margin: 0 0 8px;
        color: #a78bfa;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
      }

      h2 {
        margin: 0;
        font-size: clamp(27px, 4vw, 38px);
        letter-spacing: -1px;
        line-height: 1.3;
      }

      .section-note {
        max-width: 350px;
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .project-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .project-card {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.025);
        transition:
          transform 0.25s,
          border-color 0.25s,
          background 0.25s;
      }

      .project-card:hover {
        transform: translateY(-5px);
        border-color: rgba(167, 139, 250, 0.45);
        background: rgba(255, 255, 255, 0.045);
      }

      .project-visual {
        display: grid;
        min-height: 190px;
        place-items: center;
        padding: 25px;
        background:
          radial-gradient(
            circle at 50% 50%,
            var(--glow),
            transparent 68%
          ),
          #17171c;
      }

      .project-visual.purple {
        --glow: rgba(139, 92, 246, 0.3);
      }

      .project-visual.blue {
        --glow: rgba(59, 130, 246, 0.28);
      }

      .project-visual.green {
        --glow: rgba(16, 185, 129, 0.23);
      }

      .mock-window {
        width: 100%;
        max-width: 260px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 9px;
        background: rgba(10, 10, 14, 0.92);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
        transform: rotate(-2deg);
        transition: transform 0.3s;
      }

      .project-card:hover .mock-window {
        transform: rotate(0) scale(1.025);
      }

      .mock-top {
        display: flex;
        gap: 4px;
        padding: 9px;
        border-bottom: 1px solid var(--line);
      }

      .mock-top i {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #71717a;
      }

      .mock-content {
        padding: 17px;
      }

      .mock-label {
        color: #a78bfa;
        font-size: 8px;
        letter-spacing: 1px;
      }

      .mock-title {
        margin-top: 8px;
        font-size: 19px;
        font-weight: 800;
        line-height: 1.4;
      }

      .mock-line {
        width: 80%;
        height: 4px;
        margin-top: 9px;
        border-radius: 99px;
        background: #3f3f46;
      }

      .mock-line.short {
        width: 48%;
        margin-top: 5px;
      }

      .project-body {
        padding: 22px;
      }

      .project-category {
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 1.2px;
      }

      .project-body h3 {
        margin: 10px 0;
        font-size: 20px;
      }

      .project-body p {
        min-height: 50px;
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 19px;
      }

      .tag {
        padding: 5px 9px;
        border: 1px solid var(--line);
        border-radius: 7px;
        color: #d4d4d8;
        font-size: 10px;
      }

      .demo-notice {
        margin-top: 18px;
        color: #71717a;
        font-size: 11px;
      }

      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
      }

      .about-copy {
        color: var(--muted);
        font-size: 14px;
        line-height: 2;
      }

      .about-copy strong {
        color: var(--text);
      }

      .skill-list {
        display: grid;
        gap: 0;
      }

      .skill-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 17px 0;
        border-bottom: 1px solid var(--line);
      }

      .skill-name {
        font-size: 13px;
        font-weight: 700;
      }

      .skill-level {
        color: var(--muted);
        font-size: 11px;
        text-align: right;
      }

      .service-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .service-card {
        padding: 25px;
        border: 1px solid var(--line);
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.025);
      }

      .service-number {
        color: #a78bfa;
        font-size: 12px;
        font-weight: 800;
      }

      .service-card h3 {
        margin: 20px 0 10px;
        font-size: 17px;
      }

      .service-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .contact-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 42px;
        border: 1px solid rgba(167, 139, 250, 0.25);
        border-radius: 20px;
        background:
          radial-gradient(
            ellipse at 100% 0,
            rgba(139, 92, 246, 0.17),
            transparent 55%
          ),
          #111114;
      }

      .contact-panel p {
        max-width: 500px;
        margin: 13px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      footer {
        padding: 27px 0;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 11px;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      @media (max-width: 800px) {
        .nav-inner {
          height: 64px;
        }

        .nav-links {
          gap: 15px;
        }

        .nav-links a:not(.nav-cta) {
          display: none;
        }

        .hero {
          padding: 85px 0 70px;
        }

        .project-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .project-card:last-child {
          grid-column: 1 / -1;
        }

        .about-grid {
          grid-template-columns: 1fr;
          gap: 28px;
        }

        .service-grid {
          grid-template-columns: 1fr;
        }

        .contact-panel {
          align-items: flex-start;
          flex-direction: column;
          padding: 28px;
        }
      }

      @media (max-width: 520px) {
        .container {
          width: calc(100% - 32px);
        }

        .brand {
          font-size: 15px;
        }

        .nav-cta {
          padding: 8px 10px;
          font-size: 11px;
        }

        h1 {
          font-size: 43px;
          letter-spacing: -2px;
        }

        .hero-description {
          font-size: 14px;
        }

        .hero-meta {
          gap: 12px;
          margin-top: 35px;
        }

        .section {
          padding: 58px 0;
        }

        .section-heading {
          align-items: flex-start;
          flex-direction: column;
          gap: 12px;
        }

        .project-grid {
          grid-template-columns: 1fr;
        }

        .project-card:last-child {
          grid-column: auto;
        }

        .project-visual {
          min-height: 180px;
        }

        .skill-item {
          align-items: flex-start;
          flex-direction: column;
          gap: 4px;
        }

        .skill-level {
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <header class="nav">
      <nav class="container nav-inner" aria-label="主导航">
        <a class="brand" href="#home" aria-label="返回首页">
          <span class="brand-icon">✳</span>
          <span>DEV<span class="gradient-text">SPACE</span></span>
        </a>

        <div class="nav-links">
          <a href="#projects">作品展示</a>
          <a href="#about">关于我</a>
          <a href="#services">服务介绍</a>
          <a class="nav-cta" href="#contact">联系我 ↗</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero container" id="home">
        <div class="eyebrow">
          <span class="status-dot"></span>
          个人网站开发 · 作品集展示
        </div>

        <h1>
          把想法，<br />
          <span class="gradient-text">变成真正可用的网站。</span>
        </h1>

        <p class="hero-description">
          专注于简洁、现代、响应式的网站设计与开发。<br />
          从个人主页到产品展示页面，让每一个想法都有自己的网络空间。
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            查看演示作品 <span>↘</span>
          </a>
          <a class="button button-secondary" href="#contact">
            了解建站服务 <span>↗</span>
          </a>
        </div>

        <div class="hero-meta">
          <span>响应式网页设计</span>
          <span>现代前端技术</span>
          <span>网站部署上线</span>
        </div>
      </section>

      <section class="section" id="projects">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-kicker">SELECTED WORK</p>
              <h2>演示作品</h2>
            </div>
            <p class="section-note">
              以下为个人练习与展示案例，用于呈现页面布局和设计方向。
            </p>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <article class="project-card">
                  <div class={`project-visual ${project.color}`}>
                    <div class="mock-window">
                      <div class="mock-top">
                        <i></i><i></i><i></i>
                      </div>
                      <div class="mock-content">
                        <div class="mock-label">{project.category}</div>
                        <div class="mock-title">{project.title}</div>
                        <div class="mock-line"></div>
                        <div class="mock-line short"></div>
                      </div>
                    </div>
                  </div>

                  <div class="project-body">
                    <div class="project-category">
                      {project.number} / DEMO PROJECT
                    </div>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <div class="tag-list">
                      {project.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <p class="demo-notice">
            注：当前展示为设计演示，不代表已交付的真实客户项目。
          </p>
        </div>
      </section>

      <section class="section" id="about">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-kicker">ABOUT & SKILLS</p>
              <h2>关于我</h2>
            </div>
          </div>

          <div class="about-grid">
            <div class="about-copy">
              <p>
                你好，欢迎来到我的作品集。
              </p>
              <p>
                专注于现代网站开发与部署，持续探索简洁、实用的网页设计方案。目前主要制作个人主页、作品集网站和产品展示页面。
              </p>
              <p>
                这个网站既是我的学习项目，也是探索个人建站服务的第一份演示作品。
                页面内容会随着实际项目经验不断完善。
              </p>
            </div>

            <div class="skill-list">
              {
                skills.map((skill) => (
                  <div class="skill-item">
                    <span class="skill-name">{skill.name}</span>
                    <span class="skill-level">{skill.level}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="services">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-kicker">WHAT I CAN BUILD</p>
              <h2>服务方向</h2>
            </div>
            <p class="section-note">
              根据实际需求沟通页面范围、交付内容与上线方式。
            </p>
          </div>

          <div class="service-grid">
            <article class="service-card">
              <span class="service-number">01 / WEBSITE</span>
              <h3>个人主页搭建</h3>
              <p>
                用于展示个人简介、技能、项目经历与联系方式，
                适合个人作品集和求职展示。
              </p>
            </article>

            <article class="service-card">
              <span class="service-number">02 / SHOWCASE</span>
              <h3>展示型网站</h3>
              <p>
                通过清晰的页面结构展示品牌、产品或服务，
                让访客快速了解核心信息。
              </p>
            </article>

            <article class="service-card">
              <span class="service-number">03 / DEPLOYMENT</span>
              <h3>网站部署上线</h3>
              <p>
                协助配置网站部署、检查页面访问情况，
                并说明后续维护与域名相关事项。
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="container">
          <div class="contact-panel">
            <div>
              <p class="section-kicker">LET'S CONNECT</p>
              <h2>有一个想法？<br />让我们聊聊。</h2>
              <p>
                如果你需要个人主页、产品展示页面或网站部署服务，
                可以先整理好需求，再讨论合适的实现方式。
              </p>
            </div>

            <a
              class="button button-primary"
              href="mailto:3573625617@qq.com"
            >
              发送邮件 <span>↗</span>
            </a>
          </div>
          <p class="demo-notice">
        
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>© 2026 Cheng Studio · 个人作品集</span>
        <span>Designed & built with Astro</span>
      </div>
    </footer>
  </body>
</html>