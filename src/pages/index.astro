    desc: "让个人介绍、专业技能与联系方式拥有清晰、专业的展示空间。",
    tags: ["个人介绍", "响应式设计"],
  },
  {
    number: "02",
    title: "项目作品集",
    desc: "展示竞赛经历、技术项目与作品成果，让你的能力更直观。",
    tags: ["项目展示", "经历梳理"],
  },
  {
    number: "03",
    title: "产品展示页",
    desc: "围绕产品价值设计页面，让访客快速理解你的产品与服务。",
    tags: ["产品介绍", "品牌展示"],
  },
];

const projects = [
  {
    number: "01",
    category: "PERSONAL PORTFOLIO",
    title: "个人作品集",
    desc: "用一个网站展示个人经历、专业技能与代表项目。",
    style: "purple",
  },
  {
    number: "02",
    category: "BRAND WEBSITE",
    title: "品牌展示网站",
    desc: "通过清晰的信息结构，建立专业、统一的品牌形象。",
    style: "blue",
  },
  {
    number: "03",
    category: "PRODUCT LANDING PAGE",
    title: "产品介绍页面",
    desc: "突出产品核心卖点，帮助访客快速了解产品价值。",
    style: "green",
  },
];

const plans = [
  {
    name: "基础主页",
    price: "99",
    desc: "适合希望拥有个人展示页面的你",
    features: [
      "单页个人主页",
      "个人信息展示",
      "基础视觉设计",
      "手机端适配",
    ],
    featured: false,
  },
  {
    name: "个人作品集",
    price: "199",
    desc: "适合学生、求职者与技术创作者",
    features: [
      "个人介绍与技能展示",
      "项目作品展示",
      "联系方式展示",
      "响应式页面设计",
      "协助部署上线",
    ],
    featured: true,
  },
  {
    name: "定制展示网站",
    price: "299",
    desc: "适合有个性化展示需求的用户",
    features: [
      "根据需求调整设计",
      "自定义展示模块",
      "个性化视觉呈现",
      "手机端适配",
      "协助部署上线",
    ],
    featured: false,
  },
];

const steps = [
  { number: "01", title: "需求沟通", desc: "了解你想展示的内容与目标。" },
  { number: "02", title: "确认方案", desc: "确定页面结构、风格与报价。" },
  { number: "03", title: "网站制作", desc: "完成页面设计、开发与调整。" },
  { number: "04", title: "测试部署", desc: "检查页面效果并协助上线。" },
