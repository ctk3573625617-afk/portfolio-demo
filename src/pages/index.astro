---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="为大学生、求职者与个人创作者提供个人主页、作品集和产品展示网站制作服务。"
    />
    <meta name="theme-color" content="#0b0b10" />
    <title>造站实验室 | 让你的想法拥有自己的网页</title>
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="#home" aria-label="造站实验室首页">
        <span class="brand-icon">Z</span>
        <span>造站实验室<span class="brand-dot">.</span></span>
      </a>

      <nav class="nav">
        <a href="#services">服务介绍</a>
        <a href="#projects">作品案例</a>
        <a href="#pricing">价格方案</a>
        <a href="#process">制作流程</a>
      </nav>

      <a class="nav-cta" href="#contact">
        咨询制作 <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main>
      <section class="hero section-wrap" id="home">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="status-dot"></span>
            PERSONAL WEBSITE STUDIO
          </div>

          <h1>
            让你的想法，<br />
            拥有一个<span class="gradient-text">真正属于</span><br />
            自己的网站<span class="gradient-text">.</span>
          </h1>

          <p class="hero-desc">
            为大学生、求职者与个人创作者制作精致的个人主页、作品集与产品展示网站。
            把你的经历与想法，变成可以分享给全世界的网页。
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#projects">
              查看作品案例 <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary" href="#pricing">
              了解服务价格 <span aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="hero-note">
            <span class="check">✓</span> 响应式页面设计
            <span class="note-separator">/</span>
            <span class="check">✓</span> 个性化视觉呈现
            <span class="note-separator">/</span>
            <span class="check">✓</span> 协助部署上线
          </div>
        </div>

        <div class="hero-visual" aria-label="个人网站界面示意图">
          <div class="visual-glow"></div>
          <div class="browser-window">
            <div class="browser-bar">
              <div class="browser-dots">
                <i></i><i></i><i></i>
              </div>
              <div class="browser-address">your-portfolio.dev</div>
              <span class="browser-menu">•••</span>
            </div>

            <div class="mock-page">
              <div class="mock-nav">
                <span class="mock-logo">PORTFOLIO.</span>
                <span class="mock-links">ABOUT　 WORK　 CONTACT</span>
              </div>

              <div class="mock-content">
                <span class="mock-label">HELLO, WORLD!</span>
                <div class="mock-heading">
                  Build your<br />
                  <span>own story.</span>
                </div>
                <div class="mock-line"></div>
                <p>Ideas, projects and everything about me.</p>
                <div class="mock-button">EXPLORE MY WORK ↗</div>
              </div>

              <div class="mock-orb orb-one"></div>
              <div class="mock-orb orb-two"></div>
              <div class="mock-footer">
                <span>DESIGN · DEVELOP · CREATE</span>
                <span>01 / 03</span>
              </div>
            </div>
          </div>

          <div class="float-card float-card-top">
            <span class="float-icon purple-icon">✳</span>
            <span><strong>专属设计</strong><small>为你的需求量身打造</small></span>
          </div>

          <div class="float-card float-card-bottom">
            <span class="float-icon green-icon">↗</span>
            <span><strong>随时分享</strong><small>一个链接展示你的作品</small></span>
          </div>

          <div class="visual-caption">YOUR IDEAS. YOUR SPACE.</div>
        </div>
      </section>

      <section class="trust-strip">
        <div class="section-wrap trust-inner">
          <span>从想法到网页</span>
          <span class="trust-divider">✳</span>
          <span>从作品到展示</span>
          <span class="trust-divider">✳</span>
          <span>从设计到上线</span>
          <span class="trust-divider">✳</span>
          <span>让每份努力被看见</span>
        </div>
      </section>

      <section class="section-wrap section-block" id="services">
        <div class="section-heading">
          <div>
            <div class="eyebrow">WHAT WE BUILD</div>
            <h2>你想展示的，<span class="muted-heading">都可以从这里开始。</span></h2>
          </div>
          <p>不需要懂复杂的技术。<br />先说出你的想法，剩下的我们一起实现。</p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <div class="card-topline">
                <span class="card-number">{service.number}</span>
                <span class="card-arrow">↗</span>
              </div>
              <div class="service-symbol">{service.number === "01" ? "◈" : service.number === "02" ? "▤" : "✳"}</div>
              <h3>{service.title}</h3>
              <p>{service.desc}</p>
              <div class="tag-row">
                {service.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="projects-section" id="projects">
        <div class="section-wrap section-block">
          <div class="section-heading">
            <div>
              <div class="eyebrow">SELECTED CONCEPTS</div>
              <h2>用实际效果，<span class="muted-heading">展示网站的可能性。</span></h2>
            </div>
            <p>以下为设计演示作品，<br />用于展示不同类型网站的设计方向。</p>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <div class={`project-preview ${project.style}`}>
                  <div class="preview-top">
                    <span class="preview-brand">{project.number === "01" ? "MY SPACE." : project.number === "02" ? "STUDIO / 01" : "NEW PRODUCT"}</span>
                    <span class="preview-menu">☰</span>
                  </div>
                  {project.number === "01" && (
                    <div class="preview-personal">
                      <span class="preview-small">A LITTLE ABOUT ME</span>
                      <div class="preview-big">Hello,<br />I'm Alex<span>.</span></div>
                      <div class="preview-pill">EXPLORE MY WORK ↗</div>
                    </div>
                  )}
                  {project.number === "02" && (
                    <div class="preview-branding">
                      <span>DESIGN FOR</span>
                      <div>BETTER<br />LIVING.</div>
                      <i>Thoughtful objects. Everyday stories.</i>
                    </div>
                  )}
                  {project.number === "03" && (
                    <div class="preview-product">
                      <div class="product-orbit"><div class="product-core"></div></div>
                      <span>LESS NOISE.<br />MORE FOCUS.</span>
                    </div>
                  )}
                  <span class="preview-index">{project.number} / 03</span>
                </div>

                <div class="project-info">
                  <div class="project-category">{project.category}</div>
                  <div class="project-title-row">
                    <h3>{project.title}</h3>
                    <span class="demo-badge">演示作品</span>
                  </div>
                  <p>{project.desc}</p>
                </div>
              </article>
            ))}
          </div>
          <div class="demo-notice">
            <span>ⓘ</span>
            当前展示内容为概念演示，并非真实客户案例。页面结构、配色和内容均可根据实际需求调整。
          </div>
        </div>
      </section>

      <section class="projects-section" id="technical-projects">
  <div class="projects-container">
    <div class="projects-heading">
      <span class="projects-tag">TECHNICAL PROJECTS</span>

      <h2>不止于网页，<br />也能理解底层技术。</h2>

      <p>
        从嵌入式硬件到控制算法，再到网页开发。
        用实际项目积累技术经验，用清晰的设计呈现作品价值。
      </p>
    </div>

    <div class="projects-grid">
      <article class="project-card">
        <div class="project-icon">🦋</div>
        <div class="project-number">PROJECT 01</div>

        <h3>仿生蝴蝶飞行控制器</h3>

        <p>
          基于 ESP32 的飞行控制项目，涉及惯性传感器数据采集、
          舵机控制、电源设计与 PCB 集成。
        </p>

        <div class="project-tags">
          <span>ESP32</span>
          <span>IMU</span>
          <span>PCB</span>
          <span>嵌入式开发</span>
        </div>
        <button class="project-detail-btn" type="button" data-project="butterfly">查看项目详情 →</button>
      </article>

      <article class="project-card">
        <div class="project-icon">🔬</div>
        <div class="project-number">PROJECT 02</div>

        <h3>糖水偏好检测装置</h3>

        <p>
          通过触摸传感器与称重模块采集实验数据，
          结合串口通信，实现行为计数与重量变化监测。
        </p>

        <div class="project-tags">
          <span>传感器</span>
          <span>ADS1232</span>
          <span>串口通信</span>
          <span>数据采集</span>
        </div>
        <button class="project-detail-btn" type="button" data-project="sugar">查看项目详情 →</button>
      </article>

      <article class="project-card">
        <div class="project-icon">🏎️</div>
        <div class="project-number">PROJECT 03</div>

        <h3>智能车控制系统</h3>

        <p>
          围绕传感器信号处理与运动控制，
          探索 ADC 滤波、姿态融合和 PID 控制算法的应用。
        </p>

        <div class="project-tags">
          <span>ADC 滤波</span>
          <span>PID</span>
          <span>姿态融合</span>
          <span>控制算法</span>
        </div>
        <button class="project-detail-btn" type="button" data-project="car">查看项目详情 →</button>
      </article>
    </div>

    <div class="projects-note">
      注：以上为个人实践项目介绍。后续可补充实物照片、设计过程与测试结果。
    </div>
  </div>
</section>

      <section class="section-wrap section-block" id="pricing">
        <div class="section-heading pricing-heading">
          <div>
            <div class="eyebrow">SIMPLE & TRANSPARENT</div>
            <h2>清楚的价格，<span class="muted-heading">放心的选择。</span></h2>
          </div>
          <p>根据你的目标选择合适的方案。<br />具体范围与最终报价以沟通确认为准。</p>
        </div>

        <div class="pricing-grid">
          {plans.map((plan) => (
            <article class={`price-card ${plan.featured ? "featured" : ""}`}>
              {plan.featured && <div class="popular-label">推荐方案</div>}
              <div class="price-name">{plan.name}</div>
              <p class="price-desc">{plan.desc}</p>
              <div class="price-line">
                <span class="currency">¥</span>
                <span class="price-number">{plan.price}</span>
                <span class="price-unit">起</span>
              </div>
              <div class="price-divider"></div>
              <div class="feature-heading">方案包含</div>
              <ul class="feature-list">
                {plan.features.map((feature) => (
                  <li><span class="feature-check">✓</span>{feature}</li>
                ))}
              </ul>
              <a class={`price-button ${plan.featured ? "price-button-primary" : ""}`} href="#contact">
                咨询此方案 <span>↗</span>
              </a>
            </article>
          ))}
        </div>

        <p class="pricing-footnote">
          * 以上为测试参考价格。实际价格根据页面数量、功能复杂度和修改需求确定。
          域名、第三方付费服务及额外维护费用如有需要，另行沟通。
        </p>
      </section>

      <section class="process-section" id="process">
        <div class="section-wrap section-block">
          <div class="section-heading">
            <div>
              <div class="eyebrow">HOW IT WORKS</div>
              <h2>简单四步，<span class="muted-heading">把想法变成网站。</span></h2>
            </div>
            <p>过程透明，每一步都提前沟通。<br />先确认需求，再开始制作。</p>
          </div>

          <div class="process-grid">
            {steps.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>
                  {index < steps.length - 1 && <span class="process-connector">⟶</span>}
                </div>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section-wrap contact-section" id="contact">
        <div class="contact-box">
          <div class="contact-glow"></div>
          <div class="eyebrow">LET'S MAKE IT REAL</div>
          <h2>你的下一份作品，<br />值得一个更好的展示方式。</h2>
          <p>告诉我你想做什么样的网站，一起把想法变成现实。</p>
          <div class="contact-actions">
            <button class="button button-primary contact-button" id="open-wechat" type="button">
              微信联系我 <span>↗</span>
            </button>
            <a class="button contact-form-button" href="#inquiry-form">
              提交建站需求 <span>↓</span>
            </a>
          </div>
          <div class="contact-tip">添加微信时请备注“建站”，方便我了解你的来意。</div>
        </div>
      </section>

      <section class="section-wrap inquiry-section" id="inquiry-form">
        <div class="section-heading">
          <div>
            <div class="eyebrow">PROJECT INQUIRY</div>
            <h2>说说你的建站想法<span class="muted-heading">，先沟通再决定。</span></h2>
          </div>
          <p>填写需求后直接提交，我会通过你留下的联系方式与你沟通。<br />请勿填写密码、身份证号等敏感信息。</p>
        </div>
        <form class="inquiry-form" id="inquiry-form-element" action="https://submit-form.com/tv6OQu4Dt" method="POST">
          <input type="hidden" name="_subject" value="造站实验室：收到新的建站需求" />
          <label>你想制作什么类型的网站？
            <select name="website_type" required>
              <option value="">请选择</option>
              <option>个人主页</option><option>个人作品集</option><option>企业官网</option><option>产品展示页</option><option>其他</option>
            </select>
          </label>
          <label>你的预算范围？
            <select name="budget" required>
              <option value="">请选择</option>
              <option>100 元以内</option><option>100～300 元</option><option>300～500 元</option><option>500 元以上</option><option>暂不确定</option>
            </select>
          </label>
          <label>希望什么时候完成？
            <select name="deadline" required>
              <option value="">请选择</option>
              <option>3 天内</option><option>7 天内</option><option>15 天内</option><option>不着急</option>
            </select>
          </label>
          <label>你的称呼或联系方式
            <input name="contact" placeholder="填写微信号或方便联系的方式" required />
          </label>
          <label class="inquiry-wide">具体需求
            <textarea name="requirements" rows="4" placeholder="例如：想做一个个人作品集，需要哪些页面、功能或风格……" required></textarea>
          </label>
          <div class="inquiry-actions inquiry-wide">
            <button class="button button-primary" type="submit">提交建站需求 <span>↗</span></button>
            <span id="inquiry-status" role="status">提交后将由 Formspark 接收。请确保联系方式填写正确。</span>
          </div>
        </form>
      </section>

      <dialog class="wechat-dialog" id="wechat-dialog" aria-labelledby="wechat-dialog-title">
        <div class="wechat-dialog-content">
          <button class="dialog-close" id="close-wechat" type="button" aria-label="关闭微信二维码">×</button>
          <span class="projects-tag">CONTACT VIA WECHAT</span>
          <h2 id="wechat-dialog-title">添加微信，聊聊你的建站需求</h2>
          <p>请使用微信扫描下方二维码，添加时备注“建站”。</p>
          <img src="/images/wechat-qr.png" alt="微信个人二维码" class="wechat-qr-image" />
          <p class="wechat-name">微信昵称：_凌风&amp;</p>
        </div>
      </dialog>

      <dialog class="project-dialog" id="project-dialog" aria-labelledby="dialog-title">
        <div class="dialog-content">
          <button class="dialog-close" id="dialog-close" type="button" aria-label="关闭项目详情">×</button>
          <span class="projects-tag">PROJECT DETAILS</span>
          <h2 id="dialog-title">项目详情</h2>
          <p id="dialog-intro"></p>
          <h3>项目内容</h3>
          <ul id="dialog-points"></ul>
          <p class="dialog-note">项目介绍以实际完成的工作为准；可继续补充实物照片、设计过程和测试记录。</p>
        </div>
      </dialog>
    </main>

    <footer class="footer section-wrap">
      <a class="brand footer-brand" href="#home">
        <span class="brand-icon">Z</span>
        <span>造站实验室<span class="brand-dot">.</span></span>
      </a>
      <span class="footer-copy">个人网站制作与设计 · 演示项目</span>
      <a class="back-top" href="#home">返回顶部 ↑</a>
    </footer>

    <script>
      const projectDetails = {
        butterfly: {
          title: "仿生蝴蝶飞行控制器",
          intro: "结合嵌入式控制、惯性传感器和舵机驱动的实践项目。",
          points: [
            "以 ESP32 作为控制核心。",
            "使用 LSM6DSRTR 惯性传感器采集运动数据。",
            "通过舵机驱动仿生机构。",
            "涉及 PCB 设计、电源规划与硬件集成。"
          ]
        },
        sugar: {
          title: "小鼠糖水偏好检测装置",
          intro: "面向实验行为记录，结合触摸检测、重量采集和串口数据传输。",
          points: [
            "使用电容触摸传感器检测接触事件。",
            "使用称重传感器与 ADS1232 采集重量变化。",
            "规划数据通过 UART 传输至上位机。",
            "可继续补充计数逻辑、标定过程和实测结果。"
          ]
        },
        car: {
          title: "智能车控制系统",
          intro: "围绕传感器信号处理、姿态估计和运动控制开展的竞赛实践。",
          points: [
            "使用滑动平均等方法处理 ADC 信号。",
            "探索互补滤波等姿态融合方法。",
            "围绕速度与转向控制应用 PID 思路。",
            "具体效果和指标以实际调试记录为准。"
          ]
        }
      };

      const dialog = document.querySelector("#project-dialog");
      const dialogTitle = document.querySelector("#dialog-title");
      const dialogIntro = document.querySelector("#dialog-intro");
      const dialogPoints = document.querySelector("#dialog-points");
      const closeButton = document.querySelector("#dialog-close");

      document.querySelectorAll("[data-project]").forEach((button) => {
        button.addEventListener("click", () => {
          const project = projectDetails[button.dataset.project];
          if (!project || !(dialog instanceof HTMLDialogElement)) return;
          dialogTitle.textContent = project.title;
          dialogIntro.textContent = project.intro;
          dialogPoints.replaceChildren(
            ...project.points.map((point) => {
              const item = document.createElement("li");
              item.textContent = point;
              return item;
            })
          );
          dialog.showModal();
        });
      });

      closeButton?.addEventListener("click", () => {
        if (dialog instanceof HTMLDialogElement) dialog.close();
      });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
      });

      const wechatDialog = document.querySelector("#wechat-dialog");
      document.querySelector("#open-wechat")?.addEventListener("click", () => {
        if (wechatDialog instanceof HTMLDialogElement) wechatDialog.showModal();
      });
      document.querySelector("#close-wechat")?.addEventListener("click", () => {
        if (wechatDialog instanceof HTMLDialogElement) wechatDialog.close();
      });
      wechatDialog?.addEventListener("click", (event) => {
        if (event.target === wechatDialog && wechatDialog instanceof HTMLDialogElement) wechatDialog.close();
      });

      const inquiryForm = document.querySelector("#inquiry-form-element");
      const inquiryStatus = document.querySelector("#inquiry-status");
      inquiryForm?.addEventListener("submit", () => {
        if (inquiryStatus) inquiryStatus.textContent = "正在提交需求，请稍候……";
      });
    </script>
  </body>
</html>

